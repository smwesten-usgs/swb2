# Auto-detect text files and normalize to LF in the repo
* text=auto

# Source code — LF in repo, native on checkout
*.F90 text eol=lf
*.f90 text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ctl text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Build/config files
meson.build text eol=lf
meson_options.txt text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.html text eol=lf

# Binary files — do not touch
*.png binary
*.svg binary
*.pdf binary
*.nc binary
*.exe binary
*.xls binary
*.xlsx binary
*.asc binary
*.gch binary
*.ipynb binary


# ===== Linguist overrides =====
# Goal: report only Fortran and Python (our code)

# Exclude everything by default
* linguist-vendored

# Include only our source code
src/*.F90 linguist-vendored=false
src/*.f90 linguist-vendored=false
test/**/*.F90 linguist-vendored=false
test/**/*.py linguist-vendored=false

# Re-exclude vendored items within src/ and test/
src/proj4/** linguist-vendored
test/unit_tests/testdrive.F90 linguist-vendored